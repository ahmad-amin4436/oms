<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>

    <!-- Production OMS endpoint. Set this to the restaurant's OMS endpoint during deployment. -->
    <add key="OmsPrintFeedUrl"
         value="https://oms.khaneazam.com/Kitchen/KitchenPrintFeed.ashx" /> 

    <!-- Local development override: http://localhost:61905/Kitchen/KitchenPrintFeed.ashx -->
    <!-- Local development override: https://oms.khaneazam.com/Kitchen/KitchenPrintFeed.ashx -->

    <add key="ServiceName" value="KitchenPrintingAgent" />
    <add key="PollIntervalSeconds" value="5" />
    <add key="PrinterConnectionTimeoutSeconds" value="10" />
    <add key="PrinterWriteTimeoutSeconds" value="10" />

    <!-- Leave blank to use %ProgramData%\KitchenPrintingAgent\KitchenPrintingAgent.log. -->
    <add key="LogPath" value="" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
